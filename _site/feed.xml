      <item>
        <title>助动词活用表</title>
        <description>&lt;style&gt;
#auxverbtable td, #auxverbtable th {
  text-align: center;
  vertical-align: middle;
}
&lt;/style&gt;

&lt;table lang=&quot;jp&quot; id=&quot;auxverbtable&quot; class=&quot;table table-bordered table-condensed&quot;&gt;
  &lt;thead&gt;
    &lt;tr&gt;
      &lt;th&gt;接続&lt;/th&gt;
      &lt;th&gt;意味&lt;/th&gt;
      &lt;th&gt;基本形&lt;/th&gt;
      &lt;th&gt;未然形&lt;/th&gt;
      &lt;th&gt;連用形&lt;/th&gt;
      &lt;th&gt;終止形&lt;/th&gt;
      &lt;th&gt;連体形&lt;/th&gt;
      &lt;th&gt;仮定形&lt;/th&gt;
      &lt;th&gt;命令形&lt;/th&gt;
      &lt;th&gt;活用の型&lt;/th&gt;
    &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
    &lt;tr&gt;
      &lt;td rowspan=&quot;8&quot; class=&quot;info&quot;&gt;未然形&lt;/td&gt;
      &lt;td rowspan=&quot;2&quot; class=&quot;warning&quot;&gt;受身&lt;br /&gt;
      尊敬&lt;br /&gt;
      可能&lt;br /&gt;
      自発&lt;/td&gt;
      &lt;td&gt;れる&lt;/td&gt;
      &lt;td&gt;れ&lt;/td&gt;
      &lt;td&gt;れ&lt;/td&gt;
      &lt;td&gt;れる&lt;/td&gt;
      &lt;td&gt;れる&lt;/td&gt;
      &lt;td&gt;れれ&lt;/td&gt;
      &lt;td&gt;れろ&lt;br /&gt;
      れよ&lt;/td&gt;
      &lt;td rowspan=&quot;2&quot; class=&quot;success&quot;&gt;下一段型&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
      &lt;td&gt;られる&lt;/td&gt;
      &lt;td&gt;られ&lt;/td&gt;
      &lt;td&gt;られ&lt;/td&gt;
      &lt;td&gt;られる&lt;/td&gt;
      &lt;td&gt;られる&lt;/td&gt;
      &lt;td&gt;られれ&lt;/td&gt;
      &lt;td&gt;られろ&lt;br /&gt;
      られよ&lt;/td&gt;
