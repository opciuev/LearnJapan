<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#9A3412;" value="阶段 4｜L25–32 从句・语气・命令与意志（41个语法点）" vertex="1"><mxGeometry height="52" width="1500" x="180" y="10" as="geometry"/></mxCell><mxCell id="legend" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontFamily=Microsoft YaHei UI;fontSize=16;" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;★ 跟老师重点学&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;● 常用掌握&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#64748B&quot;&gt;&lt;b&gt;○ 简单自学&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry height="44" width="1340" x="260" y="70" as="geometry"/></mxCell><mxCell id="lesson_L25" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L25｜定语从句・名词修饰&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 简体小句＋名词（定语从句）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 从句中的主语：が／の；主题は不可直接使用&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="135" as="geometry"/></mxCell><mxCell id="lesson_L26" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L26｜名词化・推测&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 小句＋のが～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 小句＋のは～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 小句＋のを～&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～でしょう（较高概率推测）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～かもしれません（可能性）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ではありませんか（确认／提议）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="135" as="geometry"/></mxCell><mxCell id="lesson_L27" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L27｜时间・习惯・同时动作&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 小句＋時、～&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名词＋の時、～&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词ます形＋ながら&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ています（反复／习惯）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 名词で（原因・理由）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 人と会います&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～でしょう？（确认）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="380" as="geometry"/></mxCell><mxCell id="lesson_L28" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L28｜动作授受&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てあげます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てくれます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てもらいます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 人は 私に 物をくれます&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="380" as="geometry"/></mxCell><mxCell id="lesson_L29" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L29｜命令・禁止・定义&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词命令形&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～な（禁止）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～なさい&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～て／～ないで（指示）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ないと／～ないといけません&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～なければ／～なければなりません&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～という＋名词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～は～という～です（定义／名称）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="625" as="geometry"/></mxCell><mxCell id="lesson_L30" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L30｜意志・想法・原因&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词意志形&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～（よ）うと思います&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～（よ）うと思っています&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ので（原因・较客观）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="625" as="geometry"/></mxCell><mxCell id="lesson_L31" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L31｜条件と・副词化&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 简体小句＋と（恒常／自动结果）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ことがあります（有时）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～でしょうか（礼貌询问）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 形容词的副词性：く／に＋动词&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="870" as="geometry"/></mxCell><mxCell id="lesson_L32" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:20px&quot;&gt;L32｜计划・决定・传闻&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～つもりです&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ことにします／しました&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ことになりました&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～てほしい&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～そうです（传闻）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～によると（消息来源）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="870" as="geometry"/></mxCell><mxCell id="relations" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=3;fontColor=#7C2D12;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;主干关联&lt;/b&gt;　L22 简体形 → L25 定语从句 → L26「の」名词化；L08 物品授受 → L28 动作授受；L24「と思う」→ L30 意志；L31／L35 开始条件体系。&lt;br&gt;&lt;b&gt;重点对比&lt;/b&gt;　ことにする＝个人决定　vs　ことになる＝外部安排　｜　でしょう＝较有把握　vs　かもしれません＝可能但不确定　vs　そうです＝转述来源。&lt;/div&gt;" vertex="1"><mxGeometry height="105" width="1740" x="80" y="1125" as="geometry"/></mxCell></root></mxGraphModel>
