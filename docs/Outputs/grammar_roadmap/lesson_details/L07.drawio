<mxfile host="Electron" modified="2026-07-20T06:54:36.167Z" version="30.3.6">
  <diagram id="live-page" name="第7课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#1E3A8A;" value="第7课详解｜李さんは 毎日 コーヒーを 飲みます" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：建立动作句骨架，正确使用宾语「を」和动作场所「で」。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● 名词A か 名词B&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词A ＋ か ＋ 名词B&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　连接两个名词，表示“A或B”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;朝は パンか お粥を 食べます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;早饭吃面包或粥。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　这是选择助词；句尾疑问助词「か」的作用不同。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:20px&quot;&gt;○ ～をください&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　物品 ＋ を ＋ ください&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　在商店、餐厅等直接索取某物。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;コーヒーを ください。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;请给我咖啡。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　对动作提出请求不能直接用此句型，要用后面的「～てください」。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ 动作场所 で 动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　场所 ＋ で ＋ 动作动词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　标记动作、活动发生的地点。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;図書館で 本を 読みます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;在图书馆看书。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　存在用「に」，动作发生用「で」：図書館にあります／図書館で読みます。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="20" y="535" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ 宾语 を 动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词 ＋ を ＋ 他动词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　标记动作直接作用的对象。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;毎日 コーヒーを 飲みます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;每天喝咖啡。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　助词「を」读 o；不能按中文语序省略到难以判断对象。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="950" y="535" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　基本动作句＝主题は＋时间＋场所で＋宾语を＋动词；其他成分可按需要增加。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能准确区分：存在地点用「に」，动作发生地点用「で」，直接宾语用「を」。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="910" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
