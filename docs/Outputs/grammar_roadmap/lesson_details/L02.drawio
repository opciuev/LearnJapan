<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-07-20T08:43:16.989Z" version="30.3.6">
  <diagram id="live-page" name="第2课语法详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=31;fontStyle=1;fontColor=#142C66;" value="第2课语法详解｜从“这个”到“谁的”" vertex="1"><mxGeometry height="55" width="1350" x="250" y="10" as="geometry"/></mxCell><mxCell id="roadmap" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontFamily=Microsoft YaHei UI;fontSize=17;" value="&lt;b&gt;学习位置&lt;/b&gt;　阶段1・基础骨架　　&lt;font color=&quot;#64748B&quot;&gt;第1课 名词判断&lt;/font&gt;　→　&lt;b&gt;第2课 指示与所属&lt;/b&gt;　→　&lt;font color=&quot;#64748B&quot;&gt;第3课 场所与选择&lt;/font&gt;&lt;br&gt;&lt;b&gt;本课目标&lt;/b&gt;　会说“这个／那个／哪个／谁的”　　&lt;font color=&quot;#64748B&quot;&gt;&lt;b&gt;优先级&lt;/b&gt;　★ 跟老师重点学　　● 需要熟练　　○ 看懂即可&lt;/font&gt;" vertex="1"><mxGeometry height="88" width="1350" x="250" y="78" as="geometry"/></mxCell><mxCell id="g1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:21px&quot;&gt;● 事物指示｜これ・それ・あれ&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;句型&lt;/b&gt;　これ／それ／あれ は 名词です&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　三个词可以独立充当名词，表示“这个／那个物品”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;これは本です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这是书。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　×これ本；放到名词前时必须换成「この本」。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="580" x="30" y="175" as="geometry"/></mxCell><mxCell id="tag_g1" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=1;fontColor=#1E40AF;fontFamily=Microsoft YaHei UI;fontSize=13;fontStyle=1;" value="承接第1课｜名词判断句" vertex="1"><mxGeometry height="34" width="200" x="380" y="193" as="geometry"/></mxCell><mxCell id="g2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;★ 名词前指示｜この・その・あの&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;句型&lt;/b&gt;　この／その／あの＋名词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　放在名词前，根据距离指定某个具体的人或物。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;このカメラはスミスさんのです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这台相机是史密斯先生的。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　この／その／あの不能单独使用，后面必须有名词。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="580" x="640" y="175" as="geometry"/></mxCell><mxCell id="tag_g2" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=1;fontColor=#1E40AF;fontFamily=Microsoft YaHei UI;fontSize=13;fontStyle=1;" value="为第25课准备｜修饰名词" vertex="1"><mxGeometry height="34" width="200" x="990" y="193" as="geometry"/></mxCell><mxCell id="g3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:21px&quot;&gt;○ 人物／事物提问｜だれ・何&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;句型&lt;/b&gt;　人：だれ／どなた　　物品名称：何&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　把判断句中未知的人或物品名称替换成疑问词。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;あの人はどなたですか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;那位是谁？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　对长辈或客户询问身份时，「どなた」更礼貌。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="580" x="1250" y="175" as="geometry"/></mxCell><mxCell id="tag_g3" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=1;fontColor=#1E40AF;fontFamily=Microsoft YaHei UI;fontSize=13;fontStyle=1;" value="承接第1课｜疑问句" vertex="1"><mxGeometry height="34" width="200" x="1600" y="193" as="geometry"/></mxCell><mxCell id="g4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:21px&quot;&gt;● 多项选择｜どれ・どの&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;句型&lt;/b&gt;　どれ（独立）／どの＋名词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　在三个以上候选中询问“哪一个”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;森さんのかばんはどれですか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;森先生的包是哪一个？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「どの」后必须接名词；两项选择通常使用「どちら」。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="580" x="335" y="555" as="geometry"/></mxCell><mxCell id="tag_g4" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=1;fontColor=#1E40AF;fontFamily=Microsoft YaHei UI;fontSize=13;fontStyle=1;" value="为第3课准备｜选择问法" vertex="1"><mxGeometry height="34" width="200" x="685" y="573" as="geometry"/></mxCell><mxCell id="g5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;★ 所属与省略｜名词の名词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;句型&lt;/b&gt;　所有者＋の＋物品；已知物品可以省略&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示所属、所有或内容；「の」还可以代替已知名词。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;これは私の本です。→ これは私のです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这是我的书。→ 这是我的。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　省略的是后面的名词，不是「の」；×これは私です。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="580" x="945" y="555" as="geometry"/></mxCell><mxCell id="tag_g5" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=1;fontColor=#1E40AF;fontFamily=Microsoft YaHei UI;fontSize=13;fontStyle=1;" value="后续第25／45课｜「の」扩展" vertex="1"><mxGeometry height="34" width="200" x="1295" y="573" as="geometry"/></mxCell><mxCell id="rule" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;b&gt;本课主线&lt;/b&gt;　指示事物　→　放到名词前　→　提问“谁／什么”　→　从多个中选择　→　表达“谁的”&lt;br&gt;&lt;b&gt;判断诀窍&lt;/b&gt;　能独立使用选「～れ」；必须带名词选「～の」；两个名词之间的「の」表示所属。&lt;br&gt;&lt;b&gt;距离规律&lt;/b&gt;　こ＝近说话人　／　そ＝近听话人或承接已知　／　あ＝远离双方　／　ど＝疑问" vertex="1"><mxGeometry height="110" width="1350" x="250" y="935" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
