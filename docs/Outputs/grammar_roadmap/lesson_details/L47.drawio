<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-07-20T07:15:52.569Z" version="30.3.6">
  <diagram id="live-page" name="第47课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=32;fontStyle=1;fontColor=#5B21B6;" value="第47课详解｜尊敬语：抬高对方动作" vertex="1"><mxGeometry height="55" width="1540" x="160" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#5B21B6;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="本课目标：先识别需要尊敬的人，再从规则形、被动形和特殊动词中选择。" vertex="1"><mxGeometry height="48" width="1260" x="300" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ 尊敬语的方向&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　上级／客户等人物は＋尊敬表达&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　通过抬高对方或话题人物的动作表示敬意。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;先生はもうお帰りになりました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;老师已经回去了。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不能用来抬高自己或我方同事；先判断动作主体。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="580" x="30" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ お／ご～になります&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　お＋和语动词ます词干＋になります；ご＋汉语词干＋になります&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　规则性地把对方动作变为尊敬表达。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;社長は会議でお話しになります。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;社长在会议上讲话。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　并非所有动词都适用；单音节词或已有特殊尊敬语时慎用。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="580" x="640" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～（ら）れます（尊敬）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词被动形用作尊敬表达&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　以较简洁形式尊敬地叙述对方动作。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;部長はもう帰られました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;部长已经回去了。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　与被动形同形；尊敬句中主语是受敬者，通常没有施事「に」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="580" x="1250" y="145" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ 特殊尊敬语&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　行く／来る／いる→いらっしゃる；見る→ご覧になる；言う→おっしゃる等&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　高频动词使用专门尊敬形式。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;先生は何とおっしゃいましたか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;老师说了什么？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　特殊形式优先，不说×お言いになります来替代「おっしゃる」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="580" x="30" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～ていらっしゃいます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词て形＋いらっしゃいます&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　「ています」的尊敬表达。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;先生は研究室で待っていらっしゃいます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;老师正在研究室等候。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　动作主体必须是受敬者；说自己用「ております」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="580" x="640" y="475" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～てくださいます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词て形＋くださいます&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　「てくれます」的尊敬表达：对方为我方做。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;先生が推薦状を書いてくださいました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;老师为我写了推荐信。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　给予帮助者是受敬者；受益方向仍然朝我方。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="580" x="1250" y="475" as="geometry"/></mxCell><mxCell id="grammar_7" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● お／ご～ください&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　お＋和语词干／ご＋汉语词干＋ください&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　礼貌、尊敬地请对方做某事。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;こちらにお名前をご記入ください。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;请在这里填写姓名。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「ください」仍是请求；某些场景比「てください」更正式。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="580" x="30" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#EDE9FA;strokeColor=#7C3AED;strokeWidth=3;fontColor=#5B21B6;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　主体是对方 → 特殊尊敬语优先，其次「お／ご～になる」或「られる」；进行用「ていらっしゃる」，受惠用「てくださる」。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　先标出动作主体，再把三个普通句改成不同类型的尊敬表达。" vertex="1"><mxGeometry height="88" width="1620" x="120" y="1155" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
