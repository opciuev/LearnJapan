<mxfile host="Electron" modified="2026-07-20T07:00:59.074Z" version="30.3.6">
  <diagram id="live-page" name="第17课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#92400E;" value="第17课详解｜わたしは 新しい 洋服が 欲しいです" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：表达想要物品、想做动作，并用不同句型提出邀请或建议。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● 动词ます形＋たいです&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词ます形去ます ＋ たいです&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表达说话人想做某动作。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;週末に 映画を 見たいです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;周末想看电影。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　たい像い形容词变化；直接断定第三人称愿望通常不自然。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● 名词が 欲しいです&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　想要的物品 ＋ が ＋ 欲しいです&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表达想得到某物。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;新しい 洋服が 欲しいです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;想要新衣服。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　对象通常用「が」；“想做”不用欲しい，要用たい。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● ～ましょう&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词ます形去ます ＋ ましょう&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　主动提议和对方一起做某事。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;少し 休みましょう。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;休息一下吧。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　语气比「ませんか」更积极，可能带有推动对方行动的感觉。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="475" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● ～ませんか&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词ます否定疑问形&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　礼貌邀请对方一起做某事。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;一緒に 食事しませんか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;一起吃饭好吗？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　形式是否定，但功能是邀请，不等于单纯询问“做不做”。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:20px&quot;&gt;○ 疑问词＋でも&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　疑问词 ＋ でも ＋ 谓语&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　任举一个不特定选项，“什么都可以中的一个”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;お茶でも 飲みませんか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;喝点茶之类的好吗？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　与全面肯定「疑问词＋でも」和后续极端例用法要结合语境。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontColor=#92400E;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　欲しい的对象是名词，用「が」；たい接动词ます词干。两者主要表达说话人自身愿望。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能区分“想要什么”和“想做什么”，并根据礼貌程度选择ませんか／ましょう。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="1130" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
