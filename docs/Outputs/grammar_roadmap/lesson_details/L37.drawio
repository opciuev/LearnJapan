<mxfile host="Electron" modified="2026-07-20T07:11:07.854Z" version="30.3.6">
  <diagram id="live-page" name="第37课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=32;fontStyle=1;fontColor=#9D174D;" value="第37课详解｜条件形与口语列举" vertex="1"><mxGeometry height="55" width="1540" x="160" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#9D174D;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="本课目标：掌握ば形，比较「ば／なら」，并识别常见口语缩约和举例。" vertex="1"><mxGeometry height="48" width="1260" x="300" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ば形&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　五段う段→え段＋ば；一段去る＋れば；する→すれば；来る→来れば&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　构成假定条件的基础活用。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;書く→書けば、食べる→食べれば、する→すれば。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;书く→书けば、食べる→食べれば、する→すれば。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　い形容词是「安ければ」；名词／な形容词常用「なら」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～ば&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词ば形；い形容词去い＋ければ&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示满足前项即可产生后项，常突出一般条件。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;時間があれば、参加します。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;如果有时间就参加。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　前项是动作时，后项使用命令／意志有一定限制；「たら」更自由。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～なら&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词／な形容词＋なら；简体形＋なら&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　承接对方信息或设定话题条件：“如果是……的话”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;京都へ行くなら、秋がおすすめです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;如果去京都，推荐秋天。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　常基于已知话题给建议，不一定表示前项先发生。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="475" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● ～とか～とか&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词／简体形＋とか，……とか&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　随意列举若干例子，暗示还有其他。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;週末は映画を見るとか、本を読むとかします。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;周末会看看电影、读读书之类。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　比「や／たり」更口语；句尾结构要完整。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● 名词＋でも（举例）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词＋でも＋谓语&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　随手提出一个代表性选择：“……之类的”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;コーヒーでも飲みませんか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;喝杯咖啡什么的吧？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不表示“即使”；这里是柔和举例，意义由上下文判断。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="805" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:21px&quot;&gt;○ ～ちゃった&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词て形＋しまった→ちゃった；でしまった→じゃった&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　「てしまった」的随意口语缩约，常带遗憾。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;電車で寝ちゃった。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;在电车上睡着了。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　只用于随意会话；正式表达用「てしまいました」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=3;fontColor=#9D174D;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　ば形是形式底座；「ば」讲条件成立，「なら」承接话题；「とか／でも」负责随意举例；「ちゃった」是口语缩约。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　会变常用动词的ば形，能解释同一场景为什么用「ば」或「なら」。" vertex="1"><mxGeometry height="88" width="1620" x="120" y="1155" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
