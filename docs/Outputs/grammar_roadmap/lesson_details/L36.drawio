<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-07-20T07:10:15.190Z" version="30.3.6">
  <diagram id="live-page" name="第36课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=32;fontStyle=1;fontColor=#9D174D;" value="第36课详解｜用途、感知与偏向" vertex="1"><mxGeometry height="55" width="1540" x="160" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#9D174D;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="本课目标：说明用途和原因，把看到／听到的完整事件名词化，并识别过度偏向。" vertex="1"><mxGeometry height="48" width="1260" x="300" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～のに（用途／评价）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词辞书形＋のに＋使う／便利だ／必要だ等&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示做某事所需的用途、时间、费用或评价。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;このはさみは紙を切るのに便利です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这把剪刀用来剪纸很方便。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　这里不是“明明……却……”的逆接「のに」，看后项是否为用途评价。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～のが見えます／聞こえます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　简体形＋の＋が＋見えます／聞こえます&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示自然看见或听见一个完整事件。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;子どもたちが遊んでいるのが見えます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;能看到孩子们在玩。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「見ます／聞きます」是有意动作；「見える／聞こえる」多为自然感知。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● ～に（用途／评价基准）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词／动词辞书形＋の＋に＋便利だ／いい／必要だ&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　指出某物对某用途是否合适。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;このかばんは旅行に便利です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这个包旅行用很方便。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　动词用途要名词化为「のに」；名词用途可直接「に」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="475" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● ～て／～で（原因）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　い形容词くて；名词／な形容词＋で；部分动词て形&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　连接自然发生的原因与结果，常见于感情、状态。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;ニュースを聞いて、びっくりしました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;听到新闻后吃了一惊。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　后项一般不用强意志、命令或请求；这时用「から／ので」更自然。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● 名词＋ばかり&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词＋ばかり＋谓语&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示净是、几乎全是某类事物，常含偏多评价。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;甘い物ばかり食べています。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;净吃甜食。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不同于数量限定「だけ」；「ばかり」常带说话人评价。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="805" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～てばかりいます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词て形＋ばかりいます&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示总是做同类动作，常含批评或担忧。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;弟はゲームをしてばかりいます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;弟弟总是在打游戏。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不是一次动作；强调反复偏向，语气多不完全中性。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=3;fontColor=#9D174D;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　「に／のに」标用途；「のが見える／聞こえる」把事件当感知对象；「て／で」给原因；「ばかり」突出偏向。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能分清用途「のに」与逆接「のに」，并正确说出一条自然感知句。" vertex="1"><mxGeometry height="88" width="1620" x="120" y="1155" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
