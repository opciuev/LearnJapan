<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-07-20T06:53:19.766Z" version="30.3.6">
  <diagram id="live-page" name="第3课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#1E3A8A;" value="第3课详解｜ここは デパートです" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：能询问地点、方向和价格，并用更礼貌的指示表达接待他人。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:18px&quot;&gt;○ 名词 は いくらですか&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　物品 ＋ は ＋ いくらですか&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　询问具体价格。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;この かばんは いくらですか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这个包多少钱？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　询问数量用「いくつ」，询问金额才用「いくら」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:18px&quot;&gt;○ ここ／そこ／あそこ は 名词です&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　地点指示词 ＋ は ＋ 场所名词 ＋ です&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　指出说话人与听话人周围的地点。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;ここは デパートです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这里是百货商店。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　地点词与物品词不要混用：这里不是「これは」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="640" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:18px&quot;&gt;○ こちら／そちら／あちら／どちら&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　礼貌方向／地点指示词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　既可表示方向，也可礼貌地指地点、人物或所属单位。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;受付は あちらです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;服务台在那边。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「こちら」比「ここ」礼貌；询问公司时「どちら」需靠语境判断。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="1260" y="145" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:18px&quot;&gt;● ～ですか、～ですか（选择）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词A ＋ ですか、名词B ＋ ですか&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　列出两个候选，让对方选择。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;ここは 郵便局ですか、銀行ですか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这里是邮局还是银行？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　回答直接说选项，不必用「はい／いいえ」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="20" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:18px&quot;&gt;● 名词 は どこですか&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　要找的地点／设施 ＋ は ＋ どこですか&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　询问所在地。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;トイレは どこですか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;洗手间在哪里？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　礼貌说法可把「どこ」换为「どちら」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="640" y="475" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:18px&quot;&gt;○ 名词 は 场所です&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　主题 ＋ は ＋ 场所 ＋ です&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　用名词谓语直接说明所在地。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;食堂は デパートの 七階です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;食堂在百货商店七楼。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　这是省略「にあります」的简洁说法，只适合地点关系明确时。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="1260" y="475" as="geometry"/></mxCell><mxCell id="grammar_7" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:18px&quot;&gt;○ ～も～です&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词 ＋ も ＋ 谓语&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　在已有信息上追加“也……”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;あそこも JC企画の ビルです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;那里也是JC策划公司的大楼。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「も」通常替换主题助词「は」，不要说「はも」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="20" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　ここ／そこ／あそこ与これ／それ／あれ具有相同的こ・そ・あ距离体系。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能完成“在哪里、多少钱、A还是B”三类问答。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="1130" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
