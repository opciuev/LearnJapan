<mxfile host="Electron" modified="2026-07-20T07:01:59.433Z" version="30.3.6">
  <diagram id="live-page" name="第20课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#92400E;" value="第20课详解｜スミスさんは ピアノを 弾くことが できます" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：掌握动词基本形，并用「こと」把动作名词化以表达能力、兴趣和前后关系。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ ～ことができます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词基本形 ＋ ことができます&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表达具备做某事的能力或客观可能。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;スミスさんは ピアノを 弾くことが できます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;史密斯会弹钢琴。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　能力对象用完整动作＋こと；不要保留ます形。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● ～ことです（兴趣／内容）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词基本形 ＋ ことです&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　把动作当作名词，用于说明兴趣、内容或定义。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;私の 趣味は 写真を 撮ることです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;我的爱好是拍照。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　句尾ことです不等于说明语气「んです」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ ～前に、～&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词基本形／名词＋の ＋ 前に&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示在某动作或事件之前做另一件事。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;寝る前に 歯を 磨きます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;睡觉前刷牙。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　即使主句是过去，前项通常仍用基本形，不用た形。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="475" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:20px&quot;&gt;○ ～よね&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　句子 ＋ よね&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　既向对方提供判断，又期待对方确认或共鸣。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;この店は おいしいですよね。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这家店很好吃，对吧。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「よ」偏告知，「ね」偏确认；よね兼具两者。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ 动词基本形（辞书形）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　词典收录形式；礼貌形去除相应ます变化&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　构成普通非过去肯定，并作为多种从句接续形式。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;行きます→行く、食べます→食べる、来ます→来る&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;去→行く，吃→食べる，来→来る。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不是简单去ます；必须根据动词类别恢复词尾。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="805" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● 疑问词＋か（不定）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　疑问词 ＋ か ＋ 谓语&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示不确定的某人、某物、某处或某时。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;夏休みに どこかへ 行きたいです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;暑假想去某个地方。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　与疑问句不同，句中「か」不要求句尾再加疑问语气。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontColor=#92400E;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　基本形进入从句后可接こと、前に等；こと把动作整体当作名词处理。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能把礼貌形还原为辞书形，并用ことができます表达能力。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="1130" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
