<mxfile host="Electron" modified="2026-07-20T06:58:48.987Z" version="30.3.6">
  <diagram id="live-page" name="第16课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#166534;" value="第16课详解｜ホテルの 部屋は 広くて 明るいです" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#166534;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：连接多个性质，区分进行与结果状态，并表达“尚未”和拥有。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:20px&quot;&gt;○ ～は～が あります／います（拥有）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　拥有者 ＋ は ＋ 对象 ＋ が ＋ あります／います&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示某人或事物具有、拥有某对象。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;私は 車が あります。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;我有车。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　中文“有”的对象不用「を」；有生命对象用「います」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● ～が、～（转折）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　小句1 ＋ が、小句2&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　连接对立信息，“但是……”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;この部屋は 狭いですが、きれいです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这个房间虽小但很干净。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　句尾铺垫的「が」语气更弱；本课重点是明确转折。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ い形容词くて、～（并列）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　い形容词去い ＋ くて ＋ 后项&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　把两个性质并列描述。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;ホテルの 部屋は 広くて 明るいです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;酒店房间又宽敞又明亮。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　只能连接同一主题的性质；过去时和礼貌形式放在最后一项。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="475" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ な形容词／名词で、～（并列）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　な形容词词干／名词 ＋ で ＋ 后项&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　并列な形容词或名词判断。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;この町は 静かで 便利です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这座城市安静又方便。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不要加「な」：静かで，不是静かなで。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ ～ています（结果状态）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　瞬间变化动词て形 ＋ います&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示动作完成后留下的状态。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;田中さんは 結婚しています。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;田中已经结婚。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不是“正在结婚”；动词性质决定是进行还是结果。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="805" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● まだ～ない&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　まだ ＋ 动词否定&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示预期中的事情尚未发生。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;宿題は まだ 終わっていません。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;作业还没有完成。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　肯定「まだ」常表示“仍然”；否定时才是“还没”。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#166534;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　い形容词用「くて」连接，な形容词／名词用「で」连接；ています的含义由动词性质决定。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能从动词是否瞬间变化判断「ています」是进行还是结果。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="1130" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
