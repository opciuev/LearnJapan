<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-07-20T06:57:46.244Z" version="30.3.6">
  <diagram id="live-page" name="第13课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#166534;" value="第13课详解｜机の 上に 本が 三冊 あります" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#166534;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：正确放置数量词、持续时间、频率和移动目的表达。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:18px&quot;&gt;○ 数量＋くらい／ぐらい&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　数量词 ＋ くらい／ぐらい&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示约数，“大约……左右”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;駅まで 二十分ぐらい かかります。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;到车站大约二十分钟。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不要与程度极高的「～くらい」混淆；本课主要接数量。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:18px&quot;&gt;● 时间段に 次数＋动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　时间段 ＋ に ＋ 次数 ＋ 动词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示单位时间内的频率。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;一週間に 三回 ジムへ 行きます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;一周去三次健身房。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　这里的「に」表示比例基准，不是具体动作时间点。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="640" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:18px&quot;&gt;★ 场所へ 动词ます形に 行きます／来ます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　目的地 ＋ へ ＋ 动词ます形去ます ＋ に ＋ 移动动词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示移动的目的，“去／来做……”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;公園へ 写真を 撮りに 行きます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;去公园拍照。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　目的动词使用ます词干，不用完整「撮りますに」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="1260" y="145" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:18px&quot;&gt;★ 动词ます形（去ます）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词礼貌形去掉「ます」&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　形成后续多种语法需要的连接词干。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;休みます → 休み、食べます → 食べ&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;休息→休み；吃→食べ。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　不是所有词尾都相同变化，必须先正确得到ます形。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="20" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:18px&quot;&gt;● 数量＋で（总计）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　数量／人数 ＋ で ＋ 总价／总量&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示按该数量合计的结果。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;この りんごは 五個で 五百円です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这些苹果五个共五百日元。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　与手段「で」形式相同，此处前面是数量。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="640" y="475" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:18px&quot;&gt;● 持续时间＋动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　时间段 ＋（不加助词）＋ 持续性动词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　说明动作或状态持续多久。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;毎日 七時間 寝ます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;每天睡七个小时。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　持续时间通常不加「に」；具体时刻才常用「に」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="1260" y="475" as="geometry"/></mxCell><mxCell id="grammar_7" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=14;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:18px&quot;&gt;★ 名词＋数量词＋动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词 ＋ が／を ＋ 数量词 ＋ 动词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　数量词限定主语或宾语的数量，通常放在动词前。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;本を 三冊 買いました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;买了三本书。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　数量词不要直接放在名词前照搬中文；初级基本位置是谓语前。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="600" x="20" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#166534;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　数量词通常紧靠谓语前；频率用“时间段に次数”，持续时间一般不加助词。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能说明“多少个、多久、多久几次、去做什么”四类数量关系。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="1130" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
