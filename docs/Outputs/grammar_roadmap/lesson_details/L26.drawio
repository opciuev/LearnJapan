<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-07-20T07:06:47.070Z" version="30.3.6">
  <diagram id="live-page" name="第26课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=32;fontStyle=1;fontColor=#9A3412;" value="第26课详解｜名词化、推测与不确定" vertex="1"><mxGeometry height="55" width="1540" x="160" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="本课目标：用「の」把动作变成名词成分，并区分推测强弱。" vertex="1"><mxGeometry height="48" width="1260" x="300" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～のは～&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　简体形＋の＋は；名词／な形容词＋なのは&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　把动作或情况主题化，常用于说明、评价。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;毎朝早く起きるのは大変です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;每天早起很辛苦。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「の」把前句名词化；不要漏掉后面的主题助词「は」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～のが～&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　简体形＋の＋が；名词／な形容词＋なのが&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　把动作作为主语，常与好き、上手、見える等搭配。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;私は料理を作るのが好きです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;我喜欢做饭。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　喜好对象用「が」，不是把「私」也改成「が」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～のを～&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　简体形＋の＋を；名词／な形容词＋なのを&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　把动作作为宾语，接忘れる、知る、見る等。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;窓を閉めるのを忘れました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;忘记关窗了。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　动作若有自己的宾语，保留其「を」：窓を閉める＋のを忘れる。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="475" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～でしょう&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　简体形＋でしょう；名词／な形容词现在肯定通常直接＋でしょう&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　较有根据地推测“大概……吧”，也可柔和断定。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;明日は雨が降るでしょう。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;明天大概会下雨。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　语调上扬时也可能是确认；要结合语境和语调判断。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:21px&quot;&gt;★ ～かもしれません&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　简体形＋かもしれません；名词／な形容词现在肯定不加だ&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示可能性较低或说话人不确定：也许……。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;電車が遅れるかもしれません。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;电车也许会晚点。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　前面用简体；不要说「遅れますかもしれません」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="30" y="805" as="geometry"/></mxCell><mxCell id="grammar_6" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● ～ではありませんか&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　礼貌句／名词／な形容词＋ではありませんか&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　邀请对方确认共同认知：“不是……吗”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;この答えでいいのではありませんか。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这个答案不是可以吗？&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　可能带反问或提醒语气；口语「じゃないですか」更直接。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="880" x="950" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=3;fontColor=#9A3412;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　「の＋は／が／を」决定名词化小句在大句中的角色；「でしょう ＞ かもしれません」通常表示由强到弱的把握。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　能按句子角色选择「のは／のが／のを」，并用两个推测句型各说一句。" vertex="1"><mxGeometry height="88" width="1620" x="120" y="1155" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
