<mxfile host="Electron" modified="2026-07-20T06:58:44.205Z" version="30.3.6">
  <diagram id="live-page" name="第15课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#166534;" value="第15课详解｜小野さんは 今 新聞を 読んでいます" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#166534;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：用て形表达正在进行、许可、禁止和动作的着落点。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ ～ています（正在进行）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　持续性动词て形 ＋ います&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示说话时正在进行或当前阶段持续的动作。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;小野さんは 今 新聞を 読んでいます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;小野现在正在看报纸。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　瞬间变化动词接ています时常表示结果状态，要与L16区分。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ ～てはいけません&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词て形 ＋ はいけません&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示规则性禁止，“不可以……”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;ここで 写真を 撮ってはいけません。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这里不可以拍照。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　是在禁止动作，不要误解为动作不能实现。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ ～てもいいです&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　动词て形 ＋ もいいです&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　表示许可，“可以……”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;ここに 座ってもいいです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;可以坐这里。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　询问许可用升调「～てもいいですか」；否定回答常委婉说明。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="20" y="535" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:20px&quot;&gt;● 附着点／着落点 に 动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　位置 ＋ に ＋ 座る／置く／乗る／入る 等&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　标记动作最终接触、进入或停留的位置。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;いすに 座ってください。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;请坐在椅子上。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　动作场所用「で」，动作落到的点用「に」。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="890" x="950" y="535" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#166534;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　て形后接不同部分改变句子功能：ています＝进行，てもいい＝许可，てはいけない＝禁止。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　面对规则或现场动作，能正确选择进行、许可或禁止句型。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="910" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
