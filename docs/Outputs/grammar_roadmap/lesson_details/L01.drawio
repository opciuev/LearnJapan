<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-07-20T06:51:44.662Z" version="30.3.6">
  <diagram id="live-page" name="第1课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=32;fontStyle=1;fontColor=#1E3A8A;" value="第1课详解｜李さんは 中国人です" vertex="1"><mxGeometry height="55" width="1540" x="160" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="本课目标：能完成名词判断的肯定、否定和提问，并正确使用「の」连接两个名词。" vertex="1"><mxGeometry height="48" width="1260" x="300" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:21px&quot;&gt;● 名1 の 名2（从属・属性）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词1 ＋ の ＋ 名词2&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　名词1修饰名词2，表示所属机构、国家、性质或属性。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;李さんは JC企画の 社員です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;小李是JC策划公司的员工。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　日语顺序与中文“……的……”相反：修饰语放在前面。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="880" x="30" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:21px&quot;&gt;○ 名1 は 名2 です&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词1 ＋ は ＋ 名词2 ＋ です&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　以名词1为主题，对其身份、国籍、职业等作礼貌判断。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;李さんは 中国人です。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;小李是中国人。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　助词「は」在这里读 wa；「です」不是中文“的”。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="880" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:21px&quot;&gt;○ 名1 は 名2 ですか&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　肯定判断句 ＋ か&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　在句尾加「か」构成一般疑问句，朗读时通常升调。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;森さんは 学生ですか。—— はい、そうです。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;森先生是学生吗？—— 是的。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　回答否定可说「いいえ、ちがいます」或完整否定句。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="880" x="30" y="535" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=16;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:21px&quot;&gt;○ 名1 は 名2 では／じゃありません&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词1 ＋ は ＋ 名词2 ＋ ではありません&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　名词判断句的现在否定形式；「じゃありません」更口语。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;森さんは 学生ではありません。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;森先生不是学生。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　正式场合优先用「ではありません」；不要漏掉「は」。&lt;/div&gt;" vertex="1"><mxGeometry height="350" width="880" x="950" y="535" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　「名1 の 名2」整体可以放进判断句的名词位置：李さんは［JC企画の 社員］です。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　看到身份问题能在 5 秒内切换：です → ではありません → ですか。" vertex="1"><mxGeometry height="88" width="1620" x="120" y="945" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
