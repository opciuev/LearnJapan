<mxfile host="Electron" modified="2026-07-20T06:54:40.526Z" version="30.3.6">
  <diagram id="live-page" name="第8课详解">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#1E3A8A;" value="第8课详解｜李さんは 日本語で 手紙を 書きます" vertex="1"><mxGeometry height="55" width="1560" x="150" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="本课目标：补充动作句中的手段、对象和授受关系。" vertex="1"><mxGeometry height="48" width="1340" x="260" y="75" as="geometry"/></mxCell><mxCell id="grammar_1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ 手段／工具／语言 で 动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　名词 ＋ で ＋ 动词&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　说明完成动作所使用的工具、材料、语言或方式。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;日本語で 手紙を 書きます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;用日语写信。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　与动作场所「で」形式相同；要根据前面的名词判断语义。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="145" as="geometry"/></mxCell><mxCell id="grammar_2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ 对象 に 动词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　人 ＋ に ＋ 会います／送ります／教えます 等&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　标记动作面向的对象或接受者。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;小野さんに 電話を かけます。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;给小野打电话。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　「会います」常用「人に会う」；共同做事才用「人と」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="145" as="geometry"/></mxCell><mxCell id="grammar_3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ Aは Bに 物を あげます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　给予者A ＋ は ＋ 接受者B ＋ に ＋ 物 ＋ を ＋ あげます&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　从给予者视角表达“给别人”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;私は 小野さんに お土産を あげました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;我给了小野礼物。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　一般不用于“别人给我”；那时要用「くれます」或以我为主语说「もらいます」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="475" as="geometry"/></mxCell><mxCell id="grammar_4" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:20px&quot;&gt;★ Aは Bに／から 物を もらいます&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　接受者A ＋ は ＋ 给予者B ＋ に／から ＋ 物 ＋ を ＋ もらいます&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　从接受者视角表达“从别人那里得到”。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;私は 小野さんに 辞書を もらいました。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;我从小野那里得到一本词典。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　主语是接受者；组织机构作为来源时用「から」更自然。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="950" y="475" as="geometry"/></mxCell><mxCell id="grammar_5" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:20px&quot;&gt;○ よ（提醒／告知）&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;接续&lt;/b&gt;　句子 ＋ よ&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　把对方不知道的信息明确告知或提醒给对方。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　&lt;font color=&quot;#1D4ED8&quot;&gt;この 電車は 東京へ 行きませんよ。&lt;/font&gt;&lt;br&gt;　　　　&lt;font color=&quot;#475569&quot;&gt;这趟电车不去东京哦。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B91C1C&quot;&gt;易错&lt;/font&gt;&lt;/b&gt;　语调过强可能显得武断；已共享的信息通常更适合「ね」。&lt;/div&gt;" vertex="1"><mxGeometry height="300" width="890" x="20" y="805" as="geometry"/></mxCell><mxCell id="summary" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;b&gt;本课结构关系&lt;/b&gt;　同一个「で」可标记工具、材料、语言和交通手段；授受句则由主语决定观察视角。&lt;br&gt;&lt;b&gt;最低掌握标准&lt;/b&gt;　看到授受场景能先确定主语，再正确选择「あげます」或「もらいます」。" vertex="1"><mxGeometry height="92" width="1660" x="100" y="1130" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
