  <diagram id="live-page" name="L41-L48">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#5B21B6;" value="阶段 6｜L41–48 语态・推测・比喻与敬语（53个语法点）" vertex="1"><mxGeometry height="52" width="1500" x="180" y="10" as="geometry"/></mxCell><mxCell id="legend" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontFamily=Microsoft YaHei UI;fontSize=16;" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;★ 跟老师重点学&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;● 常用掌握&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#64748B&quot;&gt;&lt;b&gt;○ 简单自学&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry height="44" width="1340" x="260" y="70" as="geometry"/></mxCell><mxCell id="lesson_L41" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L41｜被动&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词被动形式&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Aは Bに～られます（直接被动）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Aは Bに Nを～られます（受害被动）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Nが／は～られます（无生命主语）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Nは～によって～られます（创作者／手段）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● Nは～られます（客观叙述）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～である（书面断定）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="135" as="geometry"/></mxCell><mxCell id="lesson_L42" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L42｜预期・让步・保持状态&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～はずです（逻辑预期）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～はずがありません（强烈否定预期）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～のに、～（逆接／意外）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词た／ない＋まま&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 名词＋のまま&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～ですもの／～だもん（辩解口语）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="135" as="geometry"/></mxCell><mxCell id="lesson_L43" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L43｜使役・使役被动&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词使役形式&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Aは Bを～させます（自动词）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Aは Bに Nを～させます（他动词）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词使役被动形式&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～させてください（请求许可）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～やすいです／～にくいです&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～のではないでしょうか（婉转意见）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="380" as="geometry"/></mxCell><mxCell id="lesson_L44" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L44｜样态・推测・传闻&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～そうです（样态／推测）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ようです（较正式推测）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～みたいです（口语推测）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～らしいです（传闻／推测）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～過ぎます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 形容词词干＋さ（名词化程度）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="380" as="geometry"/></mxCell><mxCell id="lesson_L45" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L45｜多重理由・变化・程度&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～し、～し（列举理由）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ば～ほど（越…越…）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ていきます／～てきました（持续变化）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てきました（新出现／接近现在）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● で／へ／から／まで／と＋の&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="625" as="geometry"/></mxCell><mxCell id="lesson_L46" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L46｜范围・比喻・典型性&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～間／～間に&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～までに（截止点）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ようです（比喻）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～みたいです（口语比喻）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～らしい＋名词（典型性）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ような味／においがします&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～んじゃないですか（婉转意见）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="625" as="geometry"/></mxCell><mxCell id="lesson_L47" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L47｜尊他语&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 尊他语的特殊动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ お／ご～になります&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～（ら）れます（尊他）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ていらっしゃいます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てくださいます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● お／ご～ください&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 敬语体系：对象与上下关系&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="870" as="geometry"/></mxCell><mxCell id="lesson_L48" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:20px&quot;&gt;L48｜自谦语・郑重语&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 自谦语的特殊动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ お／ご～します&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～させていただきます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ていただきます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ていただけますか（请求）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ております&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～でございます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～差し上げます&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="870" as="geometry"/></mxCell><mxCell id="relations" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=3;fontColor=#4C1D95;fontFamily=Microsoft YaHei UI;fontSize=16;fontStyle=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;语态・敬语主干&lt;/b&gt;　L41 被动 → L43 使役／使役被动 → L47「られる」尊他 → L48 自谦；相同形态必须按主语、受事与上下关系判断。&lt;br&gt;&lt;b&gt;推测证据对比&lt;/b&gt;　そう＝眼前样态／转述　｜　よう＝正式推断・比喻　｜　みたい＝口语推断・比喻　｜　らしい＝传闻・典型性　｜　はず＝基于逻辑的预期。&lt;br&gt;&lt;b&gt;敬语视角&lt;/b&gt;　尊他语抬高对方动作；自谦语压低己方动作；郑重语只提高整句话的礼貌度。&lt;/div&gt;" vertex="1"><mxGeometry height="115" width="1740" x="80" y="1125" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
