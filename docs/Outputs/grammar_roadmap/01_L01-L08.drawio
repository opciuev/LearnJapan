<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#1E3A8A;" value="阶段 1｜L01–08 基础骨架与助词（43个语法点）" vertex="1"><mxGeometry height="52" width="1500" x="180" y="10" as="geometry"/></mxCell><mxCell id="legend" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontFamily=Microsoft YaHei UI;fontSize=16;" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;★ 跟老师重点学&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;● 常用掌握&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#64748B&quot;&gt;&lt;b&gt;○ 简单自学&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry height="44" width="1340" x="260" y="70" as="geometry"/></mxCell><mxCell id="lesson_L01" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L01｜名词判断&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～は～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～は～では／じゃありません&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～は～ですか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 名1 の 名2（从属・属性）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="135" as="geometry"/></mxCell><mxCell id="lesson_L02" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L02｜指示词・所属&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#64748B&quot;&gt;○ これ／それ／あれ は～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ この／その／あの＋名词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ だれですか／何ですか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ どれ／どの＋名词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 名1 の 名2（所属）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="135" as="geometry"/></mxCell><mxCell id="lesson_L03" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L03｜场所・方向・价格&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ここ／そこ／あそこ は 名词です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ こちら／そちら／あちら／どちら&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 名词 は どこですか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ 名词 は いくらですか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ですか、～ですか（选择）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～も～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～は～です（场所）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="380" as="geometry"/></mxCell><mxCell id="lesson_L04" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L04｜存在句&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ あります／います&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名词は 场所に あります／います&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 名词 と 名词（并列）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ね（确认）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 上／下／前／後ろ／隣／中／外&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 疑问词＋も＋否定（全面否定）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="380" as="geometry"/></mxCell><mxCell id="lesson_L05" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L05｜时间・礼貌形时态&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#64748B&quot;&gt;○ 今～時～分です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ いつ～ますか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 时间 に 动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～から～まで（时间范围）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● は（对比）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ます／ません／ました／ませんでした&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="625" as="geometry"/></mxCell><mxCell id="lesson_L06" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L06｜移动句・交通&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 目的地 へ 移动动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 起点 から 移动动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 交通工具 で 移动动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 同伴 と 移动动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～から～まで（空间范围）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● に／で／へ／から／まで／と＋は&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="625" as="geometry"/></mxCell><mxCell id="lesson_L07" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L07｜动作句・宾语&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 宾语 を 动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动作场所 で 动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 名词A か 名词B&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～をください&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="870" as="geometry"/></mxCell><mxCell id="lesson_L08" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:20px&quot;&gt;L08｜手段・对象・授受&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 手段／语言 で 动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 对象 に 动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 人は 人に 物を あげます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 人は 人に／から 物を もらいます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ よ（提醒）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="870" as="geometry"/></mxCell><mxCell id="relations" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;主干关联&lt;/b&gt;　L01 判断句 → L04 存在句；L05 时间＋动词 → L06 移动 → L07 动作；L08 在动作句中追加手段、对象与授受。&lt;br&gt;&lt;b&gt;重点对比&lt;/b&gt;　に＝时间／目的地／对象／存在地点　｜　で＝动作场所／手段／交通工具　｜　を＝宾语／经过／离开点。&lt;/div&gt;" vertex="1"><mxGeometry height="105" width="1740" x="80" y="1125" as="geometry"/></mxCell></root></mxGraphModel>
