  <diagram id="live-page" name="L09-L16">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#166534;" value="阶段 2｜L09–16 描述・比较・数量与て形（51个语法点）" vertex="1"><mxGeometry height="52" width="1500" x="180" y="10" as="geometry"/></mxCell><mxCell id="legend" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontFamily=Microsoft YaHei UI;fontSize=16;" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;★ 跟老师重点学&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;● 常用掌握&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#64748B&quot;&gt;&lt;b&gt;○ 简单自学&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry height="44" width="1340" x="260" y="70" as="geometry"/></mxCell><mxCell id="lesson_L09" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L09｜い形容词&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#D97706&quot;&gt;● あまり～ない（不太）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～は い形容词です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～は い形容词くないです&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～は い形容词かったです&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～は い形容词くなかったです&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 宾语 を → 主题 は&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ い形容词＋名词&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="135" as="geometry"/></mxCell><mxCell id="lesson_L10" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L10｜な形容词・名词谓语&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#64748B&quot;&gt;○ そして（并列／递进）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ても（转折）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～はどうですか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ どんな＋名词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～は～です／でした&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～は～ではありません&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～は～ではありませんでした&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ な形容词＋な＋名词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名词谓语的时态・否定&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="135" as="geometry"/></mxCell><mxCell id="lesson_L11" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L11｜喜好・能力・原因&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#D97706&quot;&gt;● 场所で 事件が あります&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～から（原因・理由）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ どうしてですか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名1は 名2が 好き／嫌いです&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名1は 名2が 分かります／できます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～や～／～や～など（不完全列举）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="380" as="geometry"/></mxCell><mxCell id="lesson_L12" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L12｜比较・最高级&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Aは Bより～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Aより Bのほうが～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ Aは Bほど～くない／ではありません&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ AとBと どちらが～ですか&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 范围で いちばん～は～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 范围の中で～が いちばん～です&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● どの／どれ／どこ／いつ／何が いちばん～ですか&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="380" as="geometry"/></mxCell><mxCell id="lesson_L13" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L13｜数量・频率・ます形&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～くらい／ぐらい&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 数量 に（频率比例）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 场所へ 动词ます形に 行きます／来ます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词ます形（去ます）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 数量＋で（合计）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 时间名词＋动词&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 数量词＋动词&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="625" as="geometry"/></mxCell><mxCell id="lesson_L14" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L14｜て形・动作顺序&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词て形&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てください&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～て、～（相继发生）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てから、～（明确先后）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 场所を 经过／离开&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="625" as="geometry"/></mxCell><mxCell id="lesson_L15" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L15｜进行・许可・禁止&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ています（正在进行）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てもいいです（许可）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てはいけません（禁止）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 目的地／附着点 に 动词&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="870" as="geometry"/></mxCell><mxCell id="lesson_L16" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803D&quot; style=&quot;font-size:20px&quot;&gt;L16｜并列・结果状态&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～が、～（转折）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词て、～（并列）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ い形容词くて／な形容词で（并列）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ています（结果状态）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● まだ～ない（尚未）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～は～が あります／います（拥有）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="870" as="geometry"/></mxCell><mxCell id="relations" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#14532D;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;主干关联&lt;/b&gt;　L09／L10 形容词活用 → L12 比较 → L16 形容词并列；L13 ます形 → L14 て形 → L15／L16 的て形句型。&lt;br&gt;&lt;b&gt;重点对比&lt;/b&gt;　～ています：L15“动作正在进行” vs L16“变化后的结果状态”　｜　并列：い形容词用「くて」，な形容词／名词用「で」。&lt;/div&gt;" vertex="1"><mxGeometry height="105" width="1740" x="80" y="1125" as="geometry"/></mxCell></root></mxGraphModel>
