  <diagram id="live-page" name="L33-L40">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=30;fontStyle=1;fontColor=#9D174D;" value="阶段 5｜L33–40 状态・条件・可能与动作阶段（44个语法点）" vertex="1"><mxGeometry height="52" width="1500" x="180" y="10" as="geometry"/></mxCell><mxCell id="legend" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontFamily=Microsoft YaHei UI;fontSize=16;" value="&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;★ 跟老师重点学&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;● 常用掌握&lt;/b&gt;&lt;/font&gt;　　&lt;font color=&quot;#64748B&quot;&gt;&lt;b&gt;○ 简单自学&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry height="44" width="1340" x="260" y="70" as="geometry"/></mxCell><mxCell id="lesson_L33" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L33｜自他动词・样态・完成&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 自动词／他动词的成对理解&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 自动词＋ています（结果状态）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词ます形／形容词＋そうです（样态）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てしまいます（完成／遗憾）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～かしら（女性口语疑问）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="135" as="geometry"/></mxCell><mxCell id="lesson_L34" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L34｜结果・准备・尝试・目的&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 他动词＋てあります（人为结果）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ておきます（预先／保持）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てみます（尝试）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词基本形＋ために（目的）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名词＋のために（目的）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="135" as="geometry"/></mxCell><mxCell id="lesson_L35" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L35｜条件たら・让步・限定&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～たら、～（条件／发现）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ても、～（即使）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～しか～ない（只有）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～だけ（仅仅）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 疑问词＋でも（极端例）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="380" as="geometry"/></mxCell><mxCell id="lesson_L36" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L36｜原因・用途・感知・ばかり&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～て／～で（原因・理由）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名词に（用途／基准）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词基本形＋のに（用途／基准）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～のが見えます／聞こえます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ばかり（净是／限定）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～ばかりいます（总是做）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="380" as="geometry"/></mxCell><mxCell id="lesson_L37" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L37｜ば形・なら・列举&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词／形容词的ば形&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ば、～（条件）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～なら、～（承接话题条件）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～とか～とか（列举）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～でも（举例）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;○ ～ちゃった（てしまった口语）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="625" as="geometry"/></mxCell><mxCell id="lesson_L38" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L38｜可能・目标变化&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词可能形式&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ように、～（为了达到状态）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ようになります（能力／习惯变化）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ようにします（努力维持）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="625" as="geometry"/></mxCell><mxCell id="lesson_L39" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L39｜原因・移动方向&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词／名词＋ために（原因）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～て／～ないで（伴随状态）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ていきます／～てきます（方向）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～てきます（去后回来／接近现在）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 名词＋のために（原因）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● ～も（超出预想）&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="20" y="870" as="geometry"/></mxCell><mxCell id="lesson_L40" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#1F2937;fontFamily=Microsoft YaHei UI;fontSize=15;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;&lt;font color=&quot;#BE185D&quot; style=&quot;font-size:20px&quot;&gt;L40｜动作阶段・开始结束&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ 动词基本形＋ところです（将要）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～ているところです（正在）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～たところです（刚刚完成）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;★ ～たばかりです（主观觉得刚刚）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 动词ます形＋始めます／出します&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 动词ます形＋続けます&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;● 动词ます形＋終わります&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="890" x="950" y="870" as="geometry"/></mxCell><mxCell id="relations" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=3;fontColor=#831843;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;主干关联&lt;/b&gt;　L33 自他动词 → 结果「ている」→ L34 人为结果「てある」／准备「ておく」；L31 と → L35 たら／ても → L37 ば／なら；L39 方向变化 → L40 动作阶段。&lt;br&gt;&lt;b&gt;条件对比&lt;/b&gt;　と＝恒常／自动结果　｜　たら＝一次条件・发现　｜　ば＝一般条件　｜　なら＝承接话题给建议　｜　ても＝逆条件。&lt;/div&gt;" vertex="1"><mxGeometry height="105" width="1740" x="80" y="1125" as="geometry"/></mxCell></root></mxGraphModel>
