  <diagram id="live-page" name="第一章语法">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=32;fontStyle=1;fontColor=#172554;" value="第一章语法图｜名词判断句" vertex="1"><mxGeometry height="48" width="830" x="430" y="10" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei UI;fontSize=17;fontColor=#475569;" value="核心：名词1 は 名词2 ＋ です／ではありません／ですか" vertex="1"><mxGeometry height="36" width="870" x="410" y="58" as="geometry"/></mxCell><mxCell id="core" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E40AF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei UI;shadow=1;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:18px&quot;&gt;第1课&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;名词判断句&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;名1 は 名2 …&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#BFDBFE&quot; style=&quot;font-size:15px&quot;&gt;「は」在这里读 wa&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="240" width="300" x="60" y="350" as="geometry"/></mxCell><mxCell id="affirmative_header" parent="1" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Microsoft YaHei UI;fontSize=23;fontStyle=1;shadow=1;" value="① 肯定句" vertex="1"><mxGeometry height="70" width="190" x="470" y="140" as="geometry"/></mxCell><mxCell id="affirmative_detail" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1E3A8A;fontFamily=Microsoft YaHei UI;fontSize=17;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;公式&lt;/b&gt;　名1 は 名2 です&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　は提示主题（读作 wa）；です表示礼貌判断。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　李さんは 中国人です。　→　小李是中国人。&lt;/div&gt;" vertex="1"><mxGeometry height="160" width="650" x="710" y="95" as="geometry"/></mxCell><mxCell id="negative_header" parent="1" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EA580C;strokeColor=#C2410C;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Microsoft YaHei UI;fontSize=23;fontStyle=1;shadow=1;" value="② 否定句" vertex="1"><mxGeometry height="70" width="190" x="470" y="340" as="geometry"/></mxCell><mxCell id="negative_detail" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=2;fontColor=#7C2D12;fontFamily=Microsoft YaHei UI;fontSize=17;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;公式&lt;/b&gt;　名1 は 名2 ではありません&lt;br&gt;&lt;br&gt;&lt;b&gt;口语&lt;/b&gt;　ではありません → じゃありません&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　森さんは 学生ではありません。　→　森先生不是学生。&lt;/div&gt;" vertex="1"><mxGeometry height="160" width="650" x="710" y="295" as="geometry"/></mxCell><mxCell id="question_header" parent="1" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Microsoft YaHei UI;fontSize=23;fontStyle=1;shadow=1;" value="③ 疑问句" vertex="1"><mxGeometry height="70" width="190" x="470" y="540" as="geometry"/></mxCell><mxCell id="question_detail" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=2;fontColor=#065F46;fontFamily=Microsoft YaHei UI;fontSize=17;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;公式&lt;/b&gt;　名1 は 名2 ですか　（句尾升调）&lt;br&gt;&lt;br&gt;&lt;b&gt;肯定&lt;/b&gt;　はい、そうです。／ はい、名2です。&lt;br&gt;&lt;br&gt;&lt;b&gt;否定&lt;/b&gt;　いいえ、ちがいます。／ いいえ、名2ではありません。&lt;/div&gt;" vertex="1"><mxGeometry height="180" width="650" x="710" y="485" as="geometry"/></mxCell><mxCell id="no_header" parent="1" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#6D28D9;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Microsoft YaHei UI;fontSize=22;fontStyle=1;shadow=1;" value="④ 「の」连接" vertex="1"><mxGeometry height="70" width="190" x="470" y="750" as="geometry"/></mxCell><mxCell id="no_detail" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=2;fontColor=#5B21B6;fontFamily=Microsoft YaHei UI;fontSize=17;shadow=1;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;公式&lt;/b&gt;　名1 の 名2&lt;br&gt;&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;　连接两个名词，表示所属、从属机构／国家或属性。&lt;br&gt;&lt;br&gt;&lt;b&gt;例句&lt;/b&gt;　李さんは JC企画の 社員です。&lt;br&gt;　　　　→ 小李是JC策划公司的员工。&lt;/div&gt;" vertex="1"><mxGeometry height="180" width="650" x="710" y="695" as="geometry"/></mxCell><mxCell id="edge_affirmative" edge="1" parent="1" source="core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#2563EB;strokeWidth=3;endArrow=block;exitX=1;exitY=0.16;entryX=0;entryY=0.5;" target="affirmative_header" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="388"/><mxPoint x="420" y="175"/></Array></mxGeometry></mxCell><mxCell id="edge_negative" edge="1" parent="1" source="core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#EA580C;strokeWidth=3;endArrow=block;exitX=1;exitY=0.39;entryX=0;entryY=0.5;" target="negative_header" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="444"/><mxPoint x="420" y="375"/></Array></mxGeometry></mxCell><mxCell id="edge_question" edge="1" parent="1" source="core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#059669;strokeWidth=3;endArrow=block;exitX=1;exitY=0.62;entryX=0;entryY=0.5;" target="question_header" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="499"/><mxPoint x="420" y="575"/></Array></mxGeometry></mxCell><mxCell id="edge_no" edge="1" parent="1" source="core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#7C3AED;strokeWidth=3;endArrow=block;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" target="no_header" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="554"/><mxPoint x="420" y="785"/></Array></mxGeometry></mxCell><mxCell id="memory" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontFamily=Microsoft YaHei UI;fontSize=17;fontStyle=1;" value="记忆路线：先定主题（は） → 再作判断（です） → 否定时替换为「ではありません」 → 提问时句尾加「か」" vertex="1"><mxGeometry height="54" width="870" x="330" y="915" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
